{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chops",
  "mainBinaryName": "chops-linux",
  "version": "0.1.0",
  "identifier": "com.chops.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Chops",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["bin/chopsd"]
  }
}
